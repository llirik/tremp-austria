{
	"name": "tremp-austria",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:db": "node supabase/tests/run-rls.mjs",
		"test:e2e": "playwright test",
		"validate": "pnpm check && pnpm lint && pnpm test && pnpm test:db && pnpm build"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@fontsource-variable/heebo": "^5.3.0",
		"@js-temporal/polyfill": "^0.5.1",
		"@lucide/svelte": "^1.43.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0"
	},
	"description": "A Hebrew-first community ride board between Vienna and Bratislava Airport",
	"license": "MIT",
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@11.9.0"
}
