# From your Supabase project API settings. Public/publishable keys only.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use true only for an explicitly labeled demonstration deployment.
PUBLIC_DEMO_MODE=false
# Canonical deployment origin. Login moves here before creating its PKCE cookie.
# Use the same local origin you browse during development.
PUBLIC_SITE_URL=http://localhost:5173
# Enable only after configuring Google in Supabase Auth and its Google OAuth client.
PUBLIC_GOOGLE_AUTH_ENABLED=false
# Local development can use Supabase's local mail inbox. Production requires working SMTP.
# When unset, email sign-in defaults to true in development and false in production.
PUBLIC_EMAIL_AUTH_ENABLED=true
